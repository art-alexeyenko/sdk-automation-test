{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/content-sdk-angular/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/vercel/index"
    }
  ],
  "functions": {
    "vercel/index.mjs": {
      "includeFiles": "dist/content-sdk-angular/**"
    }
  }
}
